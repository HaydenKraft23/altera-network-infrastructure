# Include within NGINX's http context. Certificate files are NOT in this repo.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name service.example.test;

    ssl_certificate /etc/nginx/pki/frontend.crt;
    ssl_certificate_key /etc/nginx/pki/frontend.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Illustrative admin segment; replace with explicitly authorized clients.
    allow 192.0.2.0/27;
    deny all;

    location / {
        proxy_pass https://198.51.100.10:8006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_server_name on;
        proxy_ssl_name backend.example.test;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/nginx/pki/backend-ca.crt;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
