# Documentation template: change NIC and address allocation before use.
# Work from a physical console; the uplink must carry tagged VLAN 80.
auto lo
iface lo inet loopback

iface eno1 inet manual

auto vmbr0
iface vmbr0 inet manual
    bridge-ports eno1
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 80 901 902

auto vmbr0.80
iface vmbr0.80 inet static
    address 192.0.2.4/27
    gateway 192.0.2.1

source /etc/network/interfaces.d/*
